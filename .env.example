# Cogitator Configuration - EXAMPLE
# Copy this file to .env and fill in your values

# Google Gemini API key(s) for AI script generation and TTS
# Supports multiple keys for rotation if configured via keychain
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key(s) for AI script generation fallback
# Used when Gemini is unavailable or as secondary provider
# Supports multiple keys: GROQ_API_KEY_1, GROQ_API_KEY_2, etc.
GROQ_API_KEY=your_groq_api_key_here

# YouTube
PLAYLIST_URL=https://youtube.com/playlist?list=...
PLAYLIST_INDEX=1

# Game and content
GAME_TITLE=Rise of the Tomb Raider
TTS_VOICE=Vindemiatrix
CLIPS_PER_INTERVAL=5
SRT_MAX_WORDS=10
NUM_SHORTS=0

# Video clipping
PORTRAIT_CLIPS=true
BURN_CAPTIONS=true

# TTS Provider: "gemini" (API), "kokoro" (CPU/offline/free), or "edge" (free cloud)
# Kokoro is recommended: zero API cost, 54 voices, runs on CPU, offline after first download
TTS_PROVIDER=kokoro

# Voice customization (Kokoro provider)
TTS_EMOTION=default
TTS_SPEED=1.0

# Whisper model
WHISPER_MODEL=medium

# Subtitle styling
# SRT_FONT_NAME=Open Sans
# SRT_FONT_SIZE=24
# SRT_FONT_COLOR=FFD700
# SRT_FONT_OUTLINE=2
# SRT_FONT_SHADOW=1
# SRT_OUTLINE_COLOR=000000
# SRT_MARGIN_V=70
# SRT_BORDER_STYLE=outline
# SRT_ALIGNMENT=center
# SRT_HOOK_DELAY=10.0
# SRT_SUB_GAP=0.3
# SRT_MIN_DURATION=1.0
# SRT_MAX_DURATION=6.0

# Clip ordering and variety
# CLIP_ORDER=score
# VARIETY_SEED=

# Advanced
# WORKSPACE=~/.cogitator
# RECORDING_PATH=~/Videos/Recordings/
# TTS_STYLE=Speak in a thoughtful, soft-spoken manner with genuine warmth
# MEMORY_ENABLED=true
# CLIP_PACING=normal
